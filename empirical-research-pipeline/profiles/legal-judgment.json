      "type": "text",
      "scope": "header",
      "na": "未记载",
      "labels": ["案号"]
    },
    {
      "name": "court",
      "func": "kv_block",
      "type": "text",
      "scope": "header",
      "na": "未记载",
      "redacted_is_na": false,
      "labels": ["审理法院"]
    },
    {
      "name": "year",
      "func": "pattern",
      "type": "numeric",
      "scope": "header",
      "pattern": "[（(]\\s*(\\d{4})\\s*[）)]",
      "group": 1,
      "na": "未记载"
    },
    {
      "name": "judgment_date",
