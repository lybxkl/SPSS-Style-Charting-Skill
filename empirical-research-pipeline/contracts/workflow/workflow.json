        "output/figures/paper_figures_manifest.csv"
      ],
      "fallback": "output/chart_pack/chart_manifest.csv"
    },
    {
      "token": "output/chart_pack/figures",
      "select": "directory-of",
      "from": "output/chart_pack/chart_manifest.csv",
      "cases": {
        "output/chart_pack/chart_manifest.csv": "output/chart_pack/figures"
      }
    },
    {
      "token": "output/coding/sample_flow.csv",
      "select": "first-existing",
      "paths": [
        "output/coding/sample_flow.csv",
        "output/audit/sample_flow.csv"
      ],
      "fallback": "output/audit/sample_flow.csv"
    },
    {
      "token": "output/dataset/analysis.csv",
      "select": "first-existing",
      "paths": [
        {
          "json": "research_registry.json",
          "array": "datasets",
          "field": "path"
        },
        "output/dataset/analysis.csv",
        {
          "json": "output/datasets/index.json",
          "array": "datasets",
          "field": "file"
        },
        "data/analysis.csv"
      ],
      "fallback": "output/dataset/analysis.csv"
    }
  ],
  "taskConstraints": [
    "技能包只读，不复制、不改写它。",
    "每个数字须有当前材料或实际产物依据；缺输入就明确说明，不伪造数据、N、p 值或文献。",
    "图表按技能要求生成；图注写 N 与口径。",
    "命令以当前工作流和项目覆盖为准；结果以当前门禁报告为准。",
    "draft/ 是试跑目录，改它不会让已完成的审计失效。冻结后的阶段命令才进入 scripts/。",
    "验收档 explore、submission、archive 由项目锁定。低于当前档的判据不适用。archive 才要求逐格全覆盖。"
  ],
  "acceptanceTiers": {
    "default": "submission"
  },
  "agentInstructions": [
    "有工作台时以任务卡的下一步为唯一规程。研究方法以 SKILL.md 的证据法为准。",
    "验收档为 archive 时才阅读 references/12 与 references/14 的全覆盖契约。",
    "阶段、依赖、执行步骤、可选动作和重跑范围以本次工作流声明为准，不凭旧阶段编号继续。",
    "用工作台执行登记命令，记录实际生产和体检；人工步骤按 manualInstructions 完成，不伪造人工签收。",
    "数据集先落成分析表，再写入 research_registry.json 的 id、path、key。统计、图表、终检和文稿读取注册表里第一份实际存在的数据集。可投稿档不要求逐格证据账。",
    "缺失、失效或不兼容的契约需要修复或升级；不能沿用另一版的旧通过结果。"
  ]
