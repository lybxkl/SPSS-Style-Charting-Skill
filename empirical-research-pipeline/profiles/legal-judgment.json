{
  "profile": "legal-judgment",
  "version": "1.0",
  "description": "中国裁判文书的通用抽取包。示例包：只做字段抽取，不做罪名归类、不做编码决策。",
  "sections": {
    "header": {"lines": 40},
    "dispositive": {
      "start": ["判决如下", "裁定如下"],
      "end": ["如不服本判决", "如不服本裁定", "审判人员", "扫一扫", "书记员"],
      "last": true
    }
  },
  "fields": [
