{
  "schema_version": 1,
  "source_root": "materials",
  "source_inventory": "output/audit/corpus_files.csv",
  "source_coverage": "output/source_coverage.jsonl",
  "discovery_report": "output/discovery_report.md",
  "model_plan": "output/model_plan.jsonl",
  "layout": {},
  "datasets": [
    {
      "id": "person",
      "path": "data/person.csv",
      "key": "person_id",
      "unit": "一位受访者",
      "codebook": "data/person_codebook.md",
      "artifacts": []
    },
    {
      "id": "person_wave",
      "path": "data/person_wave.csv",
      "key": ["person_id", "wave"],
      "unit": "一位受访者的一次实际测量；按资料改写，不限制数据集形态",
      "codebook": "data/person_wave_codebook.md",
      "provenance": "data/person_wave_provenance.jsonl",
      "review": "data/person_wave_review.jsonl",
      "artifacts": []
    }
  ],
  "joins": [
    {
      "left": "person",
      "right": "person_wave",
      "on": "person_id",
      "how": "left",
      "expect": "1:N",
      "unit": "一位受访者的一次测量；relation_conformance.py 核孤儿/fan-out/行数对账"
    }
  ]
}
