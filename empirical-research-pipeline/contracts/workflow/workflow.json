{
  "schema": "dsa.workflow/1",
  "id": "empirical-research-pipeline",
  "version": "1.0.0",
  "requiredFeatures": [
    "dag-v1",
    "bindings-v1",
    "actions-v1",
    "gate-admission-v1",
    "ui-v1"
  ],
  "workspace": {
    "directories": [
      "data",
      "docs",
      "draft",
      "output",
      "scripts",
      "runs"
    ]
  },
  "stages": [
    {
      "id": "scope",
      "index": 1,
      "name": "范围与口径",
      "short": "范围",
      "purpose": "研究问题、时间窗、纳入/排除标准写成 docs/scope.md",
      "script": null,
      "args": [],
      "artifacts": [
        "docs/scope.md"
      ],
      "dependsOn": [],
      "admission": {},
      "afterRun": {
        "checkpoint": "data-ready",
        "requireComplete": false
      },
      "inspectionStages": [],
      "manualInstructions": [
        "写 docs/scope.md，至少包含：研究问题、分析单位、时间窗、纳入/排除标准、关键变量的操作化口径、已知局限。",
        "这一步不产生数字；不要为了「看起来完整」编造样本量或文献引用。",
        "写完后在工作台点「刷新」，scope 闸门会检查文件是否存在且非空。"
      ],
      "ui": {
        "panels": [],
        "draftTask": "scope"
      },
      "legacyAdmission": {}
    },
    {
      "id": "audit",
      "index": 2,
      "name": "资料审计",
      "short": "审计",
      "purpose": "逐份文件的可读性、重复、类型与字数审计；同时生成去重计划",
      "script": "scripts/audit_corpus.py",
      "args": [
        "--root",
        "data",
        "--out-dir",
        "output/audit",
        "--min-chars",
        "100",
        "--content-dedupe"
      ],
      "steps": [
        {
          "script": "scripts/audit_corpus.py",
          "args": [
            "--root",
            "data",
            "--out-dir",
            "output/audit",
            "--min-chars",
            "100",
            "--content-dedupe"
          ],
          "produces": [
            "output/audit/corpus_files.csv",
            "output/audit/corpus_summary.json",
            "output/audit/sample_flow.csv",
            "output/audit/corpus_audit.csv",
            "output/audit/corpus_duplicates.csv",
            "output/audit/corpus_report.md"
          ]
        },
        {
          "script": "scripts/dedupe_corpus.py",
          "args": [
            "--root",
            "data",
            "--audit",
            "output/audit/corpus_files.csv",
            "--out-dir",
            "output/audit"
          ],
          "produces": [
            "output/audit/dedupe_plan.csv"
          ],
          "continueOnError": true
        }
      ],
      "artifacts": [
        "output/audit/sample_flow.csv",
        "output/audit/corpus_summary.json",
        "output/audit/dedupe_plan.csv"
      ],
      "dependsOn": [
        "scope"
      ],
      "admission": {
        "gates": [
          "scope-doc",
          "sources-mounted",
          "sources-outside"
        ]
      },
      "afterRun": {
        "checkpoint": "data-ready",
        "reportStages": [
          "scope",
          "audit"
        ],
        "requireComplete": false
      },
      "inspectionStages": [
        "audit"
      ],
      "manualInstructions": [],
      "ui": {
        "panels": [
          "corpus"
        ],
        "draftTask": "",
        "artifactPrefixes": [
          "output/audit/"
        ]
      },
      "legacyAdmission": {}
    },
    {
      "id": "coding",
      "index": 3,
      "name": "编码与抽取",
      "short": "编码",
      "purpose": "按 profile 生成编码表；有 extract_profile.json 时落 dataset.csv 与 evidence.jsonl",
      "script": "scripts/make_coding_sheet.py",
      "args": [
        "--root",
        "data",
        "--out",
        "output/coding",
        "--audit",
        "output/audit/corpus_files.csv"
      ],
      "optionalArgs": [
        {
          "flag": "--dedupe-plan",
          "file": "output/audit/dedupe_plan.csv"
        },
        {
          "flag": "--extract",
          "file": "extract_profile.json"
        },
        {
          "flag": "--decisions",
          "file": "decisions.jsonl"
        }
      ],
      "steps": [
        {
          "script": "scripts/make_coding_sheet.py",
          "args": [
            "--root",
            "data",
            "--out",
            "output/coding",
            "--audit",
            "output/audit/corpus_files.csv"
          ],
          "optionalArgs": [
            {
              "flag": "--dedupe-plan",
              "file": "output/audit/dedupe_plan.csv"
            },
            {
              "flag": "--extract",
              "file": "extract_profile.json"
            },
            {
              "flag": "--decisions",
              "file": "decisions.jsonl"
            }
          ],
          "optionalFlags": [
            {
              "flag": "--require-review",
              "whenFile": "decisions.jsonl"
            }
          ],
          "produces": [
            "output/coding/coding_sheet.csv",
            "output/coding/sample_flow.csv",
            "output/coding/skipped_documents.csv"
          ]
        },
        {
          "script": "scripts/check_decisions.py",
          "args": [
            "--root",
            "data",
            "--decisions",
            "decisions.jsonl",
            "--out",
            "output/qa/decision_issues.csv"
          ],
          "optionalArgs": [
            {
              "flag": "--review",
              "file": "output/coding/extraction_review.csv"
            }
          ],
          "whenFile": "decisions.jsonl",
          "produces": [
            "output/qa/decision_issues.csv"
          ],
          "continueOnError": true
        }
      ],
      "artifacts": [
        "output/coding/coding_sheet.csv",
        "output/coding/sample_flow.csv",
        "output/coding/skipped_documents.csv"
      ],
      "dependsOn": [
        "audit"
      ],
      "admission": {
        "checkpoint": "data-ready",
        "reportStages": [
          "scope",
          "audit"
        ]
      },
      "afterRun": {
        "checkpoint": "data-ready",
        "reportStages": [
          "scope",
          "audit",
          "coding"
        ],
        "requireComplete": false
      },
      "inspectionStages": [
        "coding"
      ],
      "resumeFile": "docs/decisions/inclusion.md",
      "loop": {
        "draftDir": "draft",
        "freezeFile": "draft/freeze.json",
        "sampleReport": "draft/sample_errors.md"
      },
      "manualInstructions": [
        "先写 docs/decisions/inclusion.md，正文含「纳入确认：」和排除口径。没有这份确认不能全量抽取。",
        "跑已登记动作 suggest-profiles，只看示例剖面有哪些字段。抽取规则由你读样本后决定：切段起点、取第一次还是最后一次、结束符，写进项目自己的剖面或 draft/ 解析器。不要改技能包，也不要把示例剖面当成这批材料的规则。",
        "写 profile 前先跑 mine-candidates（材料挖掘候选表）：关键词/共现/主题候选行带 rel_path+行号锚，读候选是「读样本」的一部分；哪些候选成构念、进 codebook、进停用词表由你声明，主题数 K 由你定（--scan-k 只给曲线）。候选不是事实。",
        "在 draft/ 上对冻结样本试跑，把误差写进 draft/sample_errors.md。draft/ 的修改不使审计失效。",
        "样本可接受后调用 data_analysis_adopt_command，把解析器冻成该阶段命令并全量跑一次。不要手跑脚本代替回执。",
        "抽样复核走 scripts/sample_review.py：draw 带声明种子分层抽（needs_review 行强制单独成层），复核者回原文核对后只填 保持/改判/无法核对；tally 统计改判率并把没填完的样本判为未完成。不要自己挑样本。",
        "双人编码信度走 scripts/compute_kappa.py --a 甲.csv --b 乙.csv：产出 kappa_report.csv（逐变量 κ）、disagreements.csv（不一致行）与 coding-sample.md；κ<0.6 的变量会点名，重议口径后再编一轮。（未编码）占位与 *_src 溯源列自动排除；只在单侧出现的变量会点名而不是静默丢。"
      ],
      "ui": {
        "panels": [
          "corpus"
        ],
        "draftTask": "codebook",
        "artifactPrefixes": [
          "output/coding/",
          "output/mining/"
        ]
      },
      "legacyAdmission": {}
    },
    {
      "id": "dataset",
      "index": 4,
      "name": "数据集",
      "short": "数据集",
      "purpose": "清洗并构建分析表，产出全量数据报表，并在 research_registry.json 登记 id、path、key。后续统计、图表、终检和文稿读这份登记",
      "script": null,
      "args": [],
      "steps": [
        {
          "script": "scripts/clean_data.py",
          "args": [
            "--dataset",
            "output/coding/dataset.csv",
            "--recipe",
            "draft/cleaning.json",
            "--out",
            "output/cleaning",
            "--flow-out",
            "output/coding/sample_flow.csv"
          ],
          "whenFile": "draft/cleaning.json",
          "produces": [
            "output/cleaning/clean_dataset.csv",
            "output/cleaning/cleaning_log.jsonl",
            "output/cleaning/cleaning_log.md",
            "output/cleaning/flow.csv"
          ],
          "continueOnError": true
        },
        {
          "script": "scripts/report_tables.py",
          "args": [
            "--dataset",
            "output/dataset/analysis.csv",
            "--out",
            "output/reports"
          ],
          "optionalArgs": [
            {
              "flag": "--cleaning-log",
              "file": "output/cleaning/cleaning_log.jsonl"
            },
            {
              "flag": "--missing-reasons",
              "file": "output/coding/missing_by_source.csv"
            }
          ],
          "whenFile": "output/dataset/analysis.csv",
          "produces": [
            "output/reports/report_index.json",
            "output/reports/variable_report.csv",
            "output/reports/descriptive_stats.csv",
            "output/reports/frequency_tables.csv",
            "output/reports/crosstabs.csv",
            "output/reports/missing_report.csv",
            "output/reports/missing_patterns.csv",
            "output/reports/duplicate_report.csv",
            "output/reports/data_report.md",
            "output/table_map.json",
            "output/doc_map.json"
          ],
          "continueOnError": true
        }
      ],
      "artifacts": [
        "output/dataset/analysis.csv"
      ],
      "dependsOn": [
        "audit",
        "coding"
      ],
      "admission": {},
      "afterRun": {
        "checkpoint": "data-ready",
        "requireComplete": false
      },
      "inspectionStages": [
        "dataset"
      ],
      "manualInstructions": [
        "分析表不在时才构建 output/dataset/analysis.csv：清洗过就从 output/cleaning/clean_dataset.csv 构建（没写 draft/cleaning.json 时才直接从 output/coding/dataset.csv）；一行一个分析单位，保留 in_analysis（0/1）。",
        "要清洗就先写 draft/cleaning.json（用 clean_data.py --emit-template 起步）：哪些列去重、哪些值映射、哪些范围算越界，都由你读过样本后声明，引擎只执行并把每一步记进 cleaning_log.jsonl。清洗不写配方 = 不执行任何清洗步骤（na_values 词汇表仍生效）。行数用 --flow-out output/coding/sample_flow.csv 自动并入，不要手抄。",
        "分析表建好后登记 research_registry.json 之前，先跑 report_tables.py 产出全量数据报表（output/reports/）：变量清单、描述统计、频率表、缺失、重复都在里面，report_index.json 把每张表锚到数据集字节。报表的 N 与文稿数字用 verify_numbers 对。",
        "dataset.csv 和编码脚本抽出的字段是候选值，不能直接当成已经核对的分析事实。进入分析表的语义字段要能对上 evidence.jsonl 的原文位置，或在 decisions.jsonl 里有一条判断。",
        "分析表已经在时，写 research_registry.json：datasets 至少一条，含 id、path、key。path 指向这张表，key 是表里真实存在且不重复的列。可投稿档不填写逐格证据账。",
        "注册表 path 是后续统计、图表、终检和文稿读取的分析表。它与另一张表并存时，只留注册表指向的那一张。",
        "登记完成后调用 data_analysis_gates(action=\"inspect\")。宽表不要放进 data/，那里是语料根。派生变量写进 docs/codebook.md。"
      ],
      "ui": {
        "panels": [
          "analysis"
        ],
        "draftTask": ""
      },
      "legacyAdmission": {}
    },
    {
      "id": "verify",
      "index": 5,
      "minTier": "archive",
      "name": "全格复核",
      "short": "复核数据",
      "purpose": "仅归档档。逐格回源与独立复算。可投稿档不进入本阶段，统计不依赖这里的 final",
      "script": "scripts/verify_dataset.py",
      "args": [
        "--registry",
        "research_registry.json",
        "--root",
        ".",
        "--out",
        "output/data_verification",
        "--stage",
        "prepare"
      ],
      "steps": [
        {
          "script": "scripts/verify_dataset.py",
          "args": [
            "--registry",
            "research_registry.json",
            "--root",
            ".",
            "--out",
            "output/data_verification",
            "--stage",
            "prepare"
          ],
          "whenFile": "research_registry.json",
          "continueOnError": true
        }
      ],
      "artifacts": [
        "output/data_verification/dataset_verification.json"
      ],
      "dependsOn": [
        "dataset"
      ],
      "admission": {
        "checkpoint": "data-ready"
      },
      "afterRun": {
        "checkpoint": "analysis-ready",
        "gates": [
          "verification-final"
        ],
        "waitingMessage": "prepare 已生成待核模板：实际逐格复读并完成 final 校验后再续跑",
        "requireComplete": false
      },
      "inspectionStages": [
        "verify"
      ],
      "manualInstructions": [],
      "ui": {
        "panels": [],
        "draftTask": "verify",
        "legacySkipWhenMissing": "research_registry.json"
      },
      "legacyAdmission": {}
    },
    {
      "id": "stats",
      "index": 6,
      "name": "统计分析",
      "short": "统计",
      "purpose": "描述统计 + 回归 + 诊断，产出 coef_*.csv 与 model_meta.json",
      "script": "scripts/auto_stats.py",
      "args": [
        "--data",
        "output/dataset/analysis.csv",
        "--out",
        "output/models",
        "--sample-flow",
        "output/coding/sample_flow.csv",
        "--vif",
        "--roc"
      ],
      "optionalArgs": [
        {
          "flag": "--config",
          "file": "chart_config.json"
        },
        {
          "flag": "--spec",
          "file": "model_spec.json"
        }
      ],
      "steps": [
        {
          "script": "scripts/auto_stats.py",
          "args": [
            "--data",
            "output/dataset/analysis.csv",
            "--out",
            "output/models",
            "--sample-flow",
            "output/coding/sample_flow.csv",
            "--vif",
            "--roc"
          ],
          "optionalArgs": [
            {
              "flag": "--config",
              "file": "chart_config.json"
            },
            {
              "flag": "--spec",
              "file": "model_spec.json"
            }
          ],
          "produces": [
            "output/models/coef_all.csv",
            "output/models/fit.csv",
            "output/models/model_meta.json"
          ]
        },
        {
          "script": "scripts/methods_pack.py",
          "args": [
            "--data",
            "output/dataset/analysis.csv",
            "--out",
            "output/methods",
            "--config",
            "methods.json"
          ],
          "whenFile": "methods.json",
          "produces": [
            "output/methods/methods_report.md",
            "output/methods/methods_manifest.csv"
          ],
          "continueOnError": true
        }
      ],
      "artifacts": [
        "output/models/model_meta.json",
        "output/models/coef_all.csv",
        "output/methods/methods_report.md"
      ],
      "dependsOn": [
        "verify"
      ],
      "admission": {
        "checkpoint": "analysis-ready"
      },
      "afterRun": {
        "checkpoint": "analysis-ready",
        "requireComplete": false
      },
      "inspectionStages": [
        "stats"
      ],
      "resumeFile": "docs/decisions/primary-models.md",
      "manualInstructions": [
        "先写 docs/decisions/primary-models.md，正文含「主分析：」，写明结局、对照和放弃的规格。数据使用 research_registry.json 里第一份数据集。",
        "模型类型与字段（logit/ols/mixed/cox/logrank、interactions/weights/impute）按 references/03-analysis-spss.md「五项现代统计」声明；字段用错类型直接报错退出，不会静默忽略。加权模型须在正文写明「SE 是模型基，不是设计基」。",
        "调用 data_analysis_sweep 给模型族表态，再用 data_analysis_register 登记实际估计的模型。",
        "登记之后用 data_analysis_run_stage(stageId=\"stats\") 留下回执。手跑 auto_stats 不会被闸门采信。"
      ],
      "ui": {
        "panels": [
          "models"
        ],
        "draftTask": ""
      },
      "legacyAdmission": {
        "checkpoint": "analysis-ready",
        "whenFile": "research_registry.json",
        "requiredInStrict": true,
        "gates": [
          "verification-final",
          "verification-fresh"
        ]
      }
    },
    {
      "id": "figures",
      "index": 7,
      "name": "出版级图表",
      "short": "图表",
      "purpose": "全景图表包与 chart_manifest.csv（dpi / px_width / N / 调色板）；有 paper.json 时出多面板图",
      "script": "scripts/auto_chart_pack.py",
      "args": [
        "--data",
        "output/dataset/analysis.csv",
        "--out",
        "output/chart_pack",
        "--no-tiff"
      ],
      "optionalArgs": [
        {
          "flag": "--config",
          "file": "chart_config.json"
        }
      ],
      "steps": [
        {
          "script": "scripts/auto_chart_pack.py",
          "args": [
            "--data",
            "output/dataset/analysis.csv",
            "--out",
            "output/chart_pack",
            "--no-tiff"
          ],
          "optionalArgs": [
            {
              "flag": "--config",
              "file": "chart_config.json"
            }
          ],
          "produces": [
            "output/chart_pack/chart_manifest.csv"
          ]
        },
        {
          "script": "scripts/paper_figures.py",
          "args": [
            "--data",
            "output/dataset/analysis.csv",
            "--paper",
            "paper.json",
            "--out",
            "output/figures"
          ],
          "whenFile": "paper.json",
          "produces": [
            "output/figures/paper_figures_manifest.csv"
          ],
          "continueOnError": true
        }
      ],
      "artifacts": [
        "output/chart_pack/chart_manifest.csv",
        "output/figures/paper_figures_manifest.csv"
      ],
      "dependsOn": [
        "stats"
      ],
      "admission": {
        "checkpoint": "analysis-ready"
      },
      "afterRun": {
        "checkpoint": "figures-ready",
        "requireComplete": false
      },
      "inspectionStages": [
        "figures",
        "qa"
      ],
      "manualInstructions": [],
      "ui": {
        "panels": [
          "figures"
        ],
        "draftTask": "figures"
      },
      "legacyAdmission": {
        "checkpoint": "analysis-ready",
        "whenFile": "research_registry.json",
        "requiredInStrict": true,
        "gates": [
          "verification-final",
          "verification-fresh"
        ]
      }
    },
    {
      "id": "manuscript",
      "index": 8,
      "name": "文稿组装",
      "short": "文稿",
      "purpose": "按 spec 组装正文、图表与题注；有 figure_map.json 时回填 600dpi 图并导出 PDF",
      "script": "scripts/assemble_manuscript.py",
      "args": [
        "--spec",
        "manuscript.json",
        "--root",
        ".",
        "--out",
        "output/manuscript.docx"
      ],
      "steps": [
        {
          "script": "scripts/assemble_manuscript.py",
          "args": [
            "--spec",
            "manuscript.json",
            "--root",
            ".",
            "--out",
            "output/manuscript.docx"
          ],
          "produces": [
            "output/manuscript.docx",
            "output/manuscript_numbers.csv",
            "output/figure_map.json",
            "output/table_map.json"
          ]
        },
        {
          "script": "scripts/export_pdf_hires.py",
          "args": [
            "--docx",
            "output/manuscript.docx",
            "--out-pdf",
            "output/manuscript.pdf",
            "--figure-map",
            "output/figure_map.json"
          ],
          "whenFile": "output/figure_map.json",
          "produces": [
            "output/manuscript.pdf"
          ],
          "continueOnError": true
        }
      ],
      "artifacts": [
        "output/manuscript.docx",
        "output/manuscript_numbers.csv",
        "output/figure_map.json",
        "output/table_map.json"
      ],
      "dependsOn": [
        "figures"
      ],
      "admission": {
        "checkpoint": "figures-ready"
      },
      "afterRun": {
        "checkpoint": "manuscript-ready",
        "requireComplete": false
      },
      "inspectionStages": [
        "manuscript"
      ],
      "resumeFile": "docs/decisions/figure-selection.md",
      "manualInstructions": [
        "先写 docs/decisions/figure-selection.md，正文含「正文图：」，列出进入正文的图号。",
        "先调 data_analysis_manuscript action=scaffold 生成骨架（按图表清单的 section 分组，figure 块的 png/caption 照抄清单，正文留「待补」；png 缺失或 status 不是 ok 的图会被跳过）。",
